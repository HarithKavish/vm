{
  "manifest_version": 3,
  "name": "VM Desktop Bridge",
  "version": "0.1.0",
  "description": "Native messaging bridge for VM Desktop web origins",
  "permissions": ["nativeMessaging", "storage"],
  "host_permissions": [
    "https://vm.harithkavish.com/*",
    "https://harithkavish.github.io/vm/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vm.harithkavish.com/*",
        "https://harithkavish.github.io/vm/*",
        "http://localhost:5173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://vm.harithkavish.com/*",
      "https://harithkavish.github.io/vm/*",
      "http://localhost:5173/*"
    ]
  }
}
